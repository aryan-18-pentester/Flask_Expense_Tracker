from flask import Flask, render_template, redirect, url_for, request, flash
from flask_sqlalchemy import SQLAlchemy
from flask_login import (
    LoginManager,
    UserMixin,
    login_user,
    login_required,
    logout_user,
    current_user
)
from werkzeug.security import generate_password_hash, check_password_hash
from sqlalchemy import func
import os


# ============================================================
# APPLICATION SETUP
# ============================================================

app = Flask(__name__)

app.config["SECRET_KEY"] = "your-secret-key-here"

# ------------------------------------------------------------
# DEFAULT DATABASE
# User model will use this database
# ------------------------------------------------------------

app.config["SQLALCHEMY_DATABASE_URI"] = "sqlite:///users.db"

# ------------------------------------------------------------
# SECOND DATABASE
# Entry model will use this database
# ------------------------------------------------------------

app.config["SQLALCHEMY_BINDS"] = {
    "data_db": "sqlite:///data.db"
}

app.config["SQLALCHEMY_TRACK_MODIFICATIONS"] = False

db = SQLAlchemy(app)


# ============================================================
# FLASK LOGIN
# ============================================================

login_manager = LoginManager()

login_manager.init_app(app)

login_manager.login_view = "login"

login_manager.login_message = "Please log in to access this page."


# ============================================================
# USER MODEL
# Stored in: users.db
# ============================================================

class User(UserMixin, db.Model):

    __tablename__ = "user"

    id = db.Column(
        db.Integer,
        primary_key=True
    )

    username = db.Column(
        db.String(80),
        unique=True,
        nullable=False
    )

    password_hash = db.Column(
        db.String(200),
        nullable=False
    )


# ============================================================
# EXPENSE MODEL
# Stored in: data.db
# ============================================================

class Entry(db.Model):

    __bind_key__ = "data_db"

    __tablename__ = "entry"

    id = db.Column(
        db.Integer,
        primary_key=True
    )

    # This corresponds to User.id in users.db
    user_id = db.Column(
        db.Integer,
        nullable=False
    )

    category = db.Column(
        db.String(200),
        nullable=False
    )

    description = db.Column(
        db.String(200),
        nullable=False
    )

    amount = db.Column(
        db.Float,
        nullable=False
    )


# ============================================================
# FLASK LOGIN USER LOADER
# ============================================================

@login_manager.user_loader
def load_user(user_id):

    return db.session.get(
        User,
        int(user_id)
    )


# ============================================================
# REGISTER
# ============================================================

@app.route("/register", methods=["GET", "POST"])
def register():

    if request.method == "POST":

        username = request.form.get(
            "username",
            ""
        ).strip()

        password = request.form.get(
            "password",
            ""
        )

        # ----------------------------------------------------
        # Validation
        # ----------------------------------------------------

        if not username:

            flash("Username is required.")

            return redirect(
                url_for("register")
            )

        if not password:

            flash("Password is required.")

            return redirect(
                url_for("register")
            )

        # ----------------------------------------------------
        # Check existing username
        # ----------------------------------------------------

        existing_user = User.query.filter_by(
            username=username
        ).first()

        if existing_user:

            flash("Username already exists.")

            return redirect(
                url_for("register")
            )

        # ----------------------------------------------------
        # Create user
        # ----------------------------------------------------

        user = User(
            username=username,
            password_hash=generate_password_hash(password)
        )

        db.session.add(user)
        db.session.commit()

        flash("Registration successful. Please log in.")

        return redirect(
            url_for("login")
        )

    return render_template(
        "register.html"
    )


# ============================================================
# LOGIN
# ============================================================

@app.route("/login", methods=["GET", "POST"])
def login():

    if request.method == "POST":

        username = request.form.get(
            "username",
            ""
        ).strip()

        password = request.form.get(
            "password",
            ""
        )

        user = User.query.filter_by(
            username=username
        ).first()

        if user and check_password_hash(
            user.password_hash,
            password
        ):

            login_user(user)

            return redirect(
                url_for("dashboard")
            )

        flash("Invalid username or password.")

    return render_template(
        "login.html"
    )


# ============================================================
# LOGOUT
# ============================================================

@app.route("/logout")
@login_required
def logout():

    logout_user()

    return redirect(
        url_for("login")
    )


# ============================================================
# DASHBOARD
# ============================================================

@app.route("/dashboard")
@login_required
def dashboard():

    # --------------------------------------------------------
    # Get only current user's expenses
    # --------------------------------------------------------

    entries = Entry.query.filter_by(
        user_id=current_user.id
    ).all()

    # --------------------------------------------------------
    # Statistics
    # --------------------------------------------------------

    stats = db.session.query(
        func.count(Entry.id),
        func.sum(Entry.amount),
        func.avg(Entry.amount),
        func.max(Entry.amount),
        func.min(Entry.amount)
    ).filter(
        Entry.user_id == current_user.id
    ).one()

    total_count = stats[0] or 0

    total_sum = (
        round(stats[1], 2)
        if stats[1] is not None
        else 0
    )

    average = (
        round(stats[2], 2)
        if stats[2] is not None
        else 0
    )

    highest = stats[3] or 0

    lowest = stats[4] or 0

    return render_template(
        "dashboard.html",

        entries=entries,

        total_count=total_count,

        total_sum=total_sum,

        average=average,

        highest=highest,

        lowest=lowest,

        active="dashboard"
    )


# ============================================================
# EXPENSES
# ============================================================

@app.route("/expenses", methods=["GET", "POST"])
@login_required
def expenses():

    # --------------------------------------------------------
    # ADD EXPENSE
    # --------------------------------------------------------

    if request.method == "POST":

        category = request.form.get(
            "category",
            ""
        ).strip()

        description = request.form.get(
            "description",
            ""
        ).strip()

        amount_string = request.form.get(
            "amount",
            ""
        ).strip()

        # ----------------------------------------------------
        # Validate text fields
        # ----------------------------------------------------

        if not category:

            flash("Category is required.")

            return redirect(
                url_for("expenses")
            )

        if not description:

            flash("Description is required.")

            return redirect(
                url_for("expenses")
            )

        # ----------------------------------------------------
        # Convert amount
        # ----------------------------------------------------

        try:

            amount = float(amount_string)

        except ValueError:

            flash("Amount must be a valid number.")

            return redirect(
                url_for("expenses")
            )

        # ----------------------------------------------------
        # Prevent negative expense
        # ----------------------------------------------------

        if amount < 0:

            flash("Amount cannot be negative.")

            return redirect(
                url_for("expenses")
            )

        # ----------------------------------------------------
        # Create Entry
        # ----------------------------------------------------

        entry = Entry(

            user_id=current_user.id,

            category=category,

            description=description,

            amount=amount
        )

        db.session.add(entry)

        db.session.commit()

        flash("Expense added successfully.")

        return redirect(
            url_for("expenses")
        )

    # --------------------------------------------------------
    # GET CURRENT USER'S EXPENSES
    # --------------------------------------------------------

    entries = Entry.query.filter_by(
        user_id=current_user.id
    ).all()

    return render_template(
        "expenses.html",

        active="expenses",

        entries=entries
    )


# ============================================================
# EDIT EXPENSE
# ============================================================

@app.route(
    "/expenses/edit/<int:entry_id>",
    methods=["GET", "POST"]
)
@login_required
def edit_expense(entry_id):

    entry = db.session.get(
        Entry,
        entry_id
    )

    # --------------------------------------------------------
    # Entry doesn't exist
    # --------------------------------------------------------

    if entry is None:

        flash("Expense not found.")

        return redirect(
            url_for("expenses")
        )

    # --------------------------------------------------------
    # Security:
    # User can edit ONLY their own expense
    # --------------------------------------------------------

    if entry.user_id != current_user.id:

        flash("Unauthorized.")

        return redirect(
            url_for("expenses")
        )

    # --------------------------------------------------------
    # POST = update
    # --------------------------------------------------------

    if request.method == "POST":

        category = request.form.get(
            "category",
            ""
        ).strip()

        description = request.form.get(
            "description",
            ""
        ).strip()

        amount_string = request.form.get(
            "amount",
            ""
        ).strip()

        if not category:

            flash("Category is required.")

            return redirect(
                url_for(
                    "edit_expense",
                    entry_id=entry.id
                )
            )

        if not description:

            flash("Description is required.")

            return redirect(
                url_for(
                    "edit_expense",
                    entry_id=entry.id
                )
            )

        try:

            amount = float(amount_string)

        except ValueError:

            flash("Amount must be a valid number.")

            return redirect(
                url_for(
                    "edit_expense",
                    entry_id=entry.id
                )
            )

        if amount < 0:

            flash("Amount cannot be negative.")

            return redirect(
                url_for(
                    "edit_expense",
                    entry_id=entry.id
                )
            )

        # ----------------------------------------------------
        # Update
        # ----------------------------------------------------

        entry.category = category

        entry.description = description

        entry.amount = amount

        db.session.commit()

        flash("Expense updated successfully.")

        return redirect(
            url_for("expenses")
        )

    # --------------------------------------------------------
    # GET = show edit form
    # --------------------------------------------------------

    return render_template(
        "edit_expense.html",
        entry=entry
    )


# ============================================================
# DELETE EXPENSE
# ============================================================

@app.route("/delete/<int:entry_id>")
@login_required
def delete(entry_id):

    entry = db.session.get(
        Entry,
        entry_id
    )

    # --------------------------------------------------------
    # Entry doesn't exist
    # --------------------------------------------------------

    if entry is None:

        flash("Expense not found.")

        return redirect(
            url_for("expenses")
        )

    # --------------------------------------------------------
    # Security check
    # --------------------------------------------------------

    if entry.user_id != current_user.id:

        flash("Unauthorized.")

        return redirect(
            url_for("expenses")
        )

    # --------------------------------------------------------
    # Delete
    # --------------------------------------------------------

    db.session.delete(entry)

    db.session.commit()

    flash("Expense deleted successfully.")

    return redirect(
        url_for("expenses")
    )


# ============================================================
# SEARCH
# ============================================================

@app.route("/search", methods=["GET"])
@login_required
def search():

    # --------------------------------------------------------
    # Pagination
    # --------------------------------------------------------

    page = request.args.get(
        "page",
        1,
        type=int
    )

    # --------------------------------------------------------
    # Search parameters
    # --------------------------------------------------------

    amount = request.args.get(
        "amount",
        type=float
    )

    category = request.args.get(
        "category",
        ""
    ).strip()

    description = request.args.get(
        "description",
        ""
    ).strip()

    price_min = request.args.get(
        "price_min",
        type=float
    )

    price_max = request.args.get(
        "price_max",
        type=float
    )

    category_filter = request.args.get(
        "category_filter",
        ""
    ).strip()

    sort_by = request.args.get(
        "sort_by",
        ""
    )

    sort_order = request.args.get(
        "sort_order",
        ""
    )

    # --------------------------------------------------------
    # Base query
    #
    # VERY IMPORTANT:
    # Only search the logged-in user's expenses.
    # --------------------------------------------------------

    query = Entry.query.filter(
        Entry.user_id == current_user.id
    )

    # --------------------------------------------------------
    # Exact amount
    # --------------------------------------------------------

    if amount is not None:

        query = query.filter(
            Entry.amount == amount
        )

    # --------------------------------------------------------
    # Category contains
    # --------------------------------------------------------

    if category:

        query = query.filter(
            Entry.category.ilike(
                f"%{category}%"
            )
        )

    # --------------------------------------------------------
    # Description contains
    # --------------------------------------------------------

    if description:

        query = query.filter(
            Entry.description.ilike(
                f"%{description}%"
            )
        )

    # --------------------------------------------------------
    # Minimum amount
    # --------------------------------------------------------

    if price_min is not None:

        query = query.filter(
            Entry.amount >= price_min
        )

    # --------------------------------------------------------
    # Maximum amount
    # --------------------------------------------------------

    if price_max is not None:

        query = query.filter(
            Entry.amount <= price_max
        )

    # --------------------------------------------------------
    # Exact category filter
    # --------------------------------------------------------

    if category_filter:

        query = query.filter(
            Entry.category == category_filter
        )

    # ========================================================
    # SORTING
    # ========================================================

    if sort_by == "amount":

        if sort_order == "asc":

            query = query.order_by(
                Entry.amount.asc()
            )

        elif sort_order == "desc":

            query = query.order_by(
                Entry.amount.desc()
            )

    elif sort_by == "category":

        if sort_order == "asc":

            query = query.order_by(
                Entry.category.asc()
            )

        elif sort_order == "desc":

            query = query.order_by(
                Entry.category.desc()
            )

    # ========================================================
    # CATEGORY DROPDOWN
    # ========================================================

    categories = (
        db.session
        .query(Entry.category)
        .filter(
            Entry.user_id == current_user.id
        )
        .distinct()
        .all()
    )

    categories = [
        category[0]
        for category in categories
        if category[0]
    ]

    # ========================================================
    # PAGINATION
    # ========================================================

    pagination = query.paginate(
        page=page,
        per_page=5,
        error_out=False
    )

    results = pagination.items

    # ========================================================
    # RENDER
    # ========================================================

    return render_template(
        "search.html",

        pagination=pagination,

        page=page,

        total_pages=pagination.pages,

        total_items=pagination.total,

        results=results,

        amount=amount,

        category=category,

        description=description,

        price_min=price_min,

        price_max=price_max,

        category_filter=category_filter,

        categories=categories,

        sort_by=sort_by,

        sort_order=sort_order
    )


# ============================================================
# HOME
# ============================================================

@app.route("/")
def home():

    if current_user.is_authenticated:

        return redirect(
            url_for("dashboard")
        )

    return redirect(
        url_for("login")
    )


# ============================================================
# DATABASE INITIALIZATION
# ============================================================

def initialize_database():

    with app.app_context():

        db.create_all()

        print()
        print("======================================")
        print("DATABASE INITIALIZATION")
        print("======================================")

        print(
            "User database:",
            db.engine.url
        )

        print(
            "Entry database:",
            db.engines["data_db"].url
        )

        print(
            "User table:",
            User.__tablename__
        )

        print(
            "Entry table:",
            Entry.__tablename__
        )

        print("======================================")
        print()


# ============================================================
# RUN APPLICATION
# ============================================================

if __name__ == "__main__":

    initialize_database()

    app.run(
        host="0.0.0.0",
        port=int(
            os.environ.get(
                "PORT",
                8000
            )
        ),
        debug=True
    )
