from flask import Flask, render_template, redirect, url_for, request, flash
from flask_sqlalchemy import SQLAlchemy
from flask_login import (
    LoginManager,
    UserMixin,
    login_user,
    login_required,
    logout_user,
    current_user
)
from werkzeug.security import generate_password_hash, check_password_hash
from sqlalchemy import func
import os

# ─────────────────────────────────────────────────────────────
# Setup
# ─────────────────────────────────────────────────────────────

app = Flask(__name__)

app.config['SECRET_KEY'] = 'your-secret-key-here'

# Default database
app.config['SQLALCHEMY_DATABASE_URI'] = 'sqlite:///users.db'

# Second database
app.config['SQLALCHEMY_BINDS'] = {
    'data_db': 'sqlite:///data.db'
}

app.config['SQLALCHEMY_TRACK_MODIFICATIONS'] = False

db = SQLAlchemy(app)

login_manager = LoginManager(app)
login_manager.login_view = 'login'


# ─────────────────────────────────────────────────────────────
# User model → users.db
# ─────────────────────────────────────────────────────────────

class User(UserMixin, db.Model):
    id = db.Column(db.Integer, primary_key=True)

    username = db.Column(
        db.String(80),
        unique=True,
        nullable=False
    )

    password_hash = db.Column(
        db.String(200),
        nullable=False
    )


# ─────────────────────────────────────────────────────────────
# Entry model → data.db
# ─────────────────────────────────────────────────────────────

class Entry(db.Model):

    __bind_key__ = 'data_db'

    id = db.Column(
        db.Integer,
        primary_key=True
    )

    user_id = db.Column(
        db.Integer,
        nullable=False
    )

    category = db.Column(
        db.String(200),
        nullable=False
    )

    description = db.Column(
        db.String(200),
        nullable=False
    )

    amount = db.Column(
        db.Float,
        nullable=False
    )


# ─────────────────────────────────────────────────────────────
# Flask-Login
# ─────────────────────────────────────────────────────────────

@login_manager.user_loader
def load_user(user_id):
    return db.session.get(User, int(user_id))


# ─────────────────────────────────────────────────────────────
# Register
# ─────────────────────────────────────────────────────────────

@app.route('/register', methods=['GET', 'POST'])
def register():

    if request.method == 'POST':

        username = request.form['username'].strip()
        password = request.form['password']

        # Check whether username already exists
        existing_user = User.query.filter_by(
            username=username
        ).first()

        if existing_user:
            flash('Username already exists.')
            return redirect(url_for('register'))

        user = User(
            username=username,
            password_hash=generate_password_hash(password)
        )

        db.session.add(user)
        db.session.commit()

        flash('Registration successful.')

        return redirect(url_for('login'))

    return render_template('register.html')


# ─────────────────────────────────────────────────────────────
# Login
# ─────────────────────────────────────────────────────────────

@app.route('/login', methods=['GET', 'POST'])
def login():

    if request.method == 'POST':

        username = request.form['username'].strip()
        password = request.form['password']

        user = User.query.filter_by(
            username=username
        ).first()

        if user and check_password_hash(
            user.password_hash,
            password
        ):

            login_user(user)

            return redirect(url_for('dashboard'))

        flash('Invalid username or password.')

    return render_template('login.html')


# ─────────────────────────────────────────────────────────────
# Logout
# ─────────────────────────────────────────────────────────────

@app.route('/logout')
@login_required
def logout():

    logout_user()

    return redirect(url_for('login'))


# ─────────────────────────────────────────────────────────────
# Dashboard
# ─────────────────────────────────────────────────────────────

@app.route('/dashboard')
@login_required
def dashboard():

    entries = Entry.query.filter_by(
        user_id=current_user.id
    ).all()

    stats = db.session.query(
        func.count(Entry.id),
        func.sum(Entry.amount),
        func.avg(Entry.amount),
        func.max(Entry.amount),
        func.min(Entry.amount)
    ).filter(
        Entry.user_id == current_user.id
    ).one()

    total_count = stats[0] or 0
    total_sum = round(stats[1], 2) if stats[1] is not None else 0
    average = round(stats[2], 2) if stats[2] is not None else 0
    highest = stats[3] or 0
    lowest = stats[4] or 0

    return render_template(
        'dashboard.html',
        entries=entries,
        total_count=total_count,
        total_sum=total_sum,
        average=average,
        highest=highest,
        lowest=lowest,
        active='dashboard'
    )


# ─────────────────────────────────────────────────────────────
# Expenses
# ─────────────────────────────────────────────────────────────

@app.route('/expenses', methods=['GET', 'POST'])
@login_required
def expenses():

    if request.method == 'POST':

        category = request.form['category'].strip()
        description = request.form['description'].strip()

        try:
            amount = float(request.form['amount'])
        except ValueError:
            flash('Amount must be a number.')
            return redirect(url_for('expenses'))

        entry = Entry(
            user_id=current_user.id,
            category=category,
            description=description,
            amount=amount
        )

        db.session.add(entry)
        db.session.commit()

        flash('Expense added successfully.')

        return redirect(url_for('expenses'))

    entries = Entry.query.filter_by(
        user_id=current_user.id
    ).all()

    return render_template(
        'expenses.html',
        active='expenses',
        entries=entries
    )


# ─────────────────────────────────────────────────────────────
# Edit expense
# ─────────────────────────────────────────────────────────────

@app.route('/expenses/edit/<int:entry_id>', methods=['GET', 'POST'])
@login_required
def edit_expense(entry_id):

    entry = db.session.get(Entry, entry_id)

    if entry is None:
        return "Expense not found", 404

    # User ownership check
    if entry.user_id != current_user.id:

        flash("Unauthorized.")

        return redirect(url_for("expenses"))

    if request.method == "POST":

        entry.category = request.form["category"].strip()
        entry.description = request.form["description"].strip()

        try:
            entry.amount = float(request.form["amount"])
        except ValueError:

            flash("Amount must be a number.")

            return redirect(
                url_for("edit_expense", entry_id=entry.id)
            )

        db.session.commit()

        flash("Expense updated successfully.")

        return redirect(url_for("expenses"))

    return render_template(
        "edit_expense.html",
        entry=entry
    )


# ─────────────────────────────────────────────────────────────
# Delete expense
# ─────────────────────────────────────────────────────────────

@app.route('/delete/<int:entry_id>')
@login_required
def delete(entry_id):

    entry = db.session.get(Entry, entry_id)

    if entry is None:
        return "Expense not found", 404

    if entry.user_id != current_user.id:

        flash("Unauthorized.")

        return redirect(url_for('expenses'))

    db.session.delete(entry)
    db.session.commit()

    flash("Expense deleted.")

    return redirect(url_for('expenses'))


# ─────────────────────────────────────────────────────────────
# Search
# ─────────────────────────────────────────────────────────────

@app.route('/search', methods=['GET'])
@login_required
def search():

    page = request.args.get(
        'page',
        1,
        type=int
    )

    amount = request.args.get(
        'amount',
        type=float
    )

    category = request.args.get(
        'category',
        ''
    ).strip()

    description = request.args.get(
        'description',
        ''
    ).strip()

    sort_by = request.args.get('sort_by')
    sort_order = request.args.get('sort_order')

    price_min = request.args.get(
        'price_min',
        type=float
    )

    price_max = request.args.get(
        'price_max',
        type=float
    )

    category_filter = request.args.get(
        'category_filter',
        ''
    ).strip()

    # ─────────────────────────────────────────────
    # Base query
    # ─────────────────────────────────────────────

    query = Entry.query.filter(
        Entry.user_id == current_user.id
    )

    # ─────────────────────────────────────────────
    # Filters
    # ─────────────────────────────────────────────

    if amount is not None:

        query = query.filter(
            Entry.amount == amount
        )

    if category:

        query = query.filter(
            Entry.category.ilike(
                f'%{category}%'
            )
        )

    if description:

        query = query.filter(
            Entry.description.ilike(
                f'%{description}%'
            )
        )

    if price_min is not None:

        query = query.filter(
            Entry.amount >= price_min
        )

    if price_max is not None:

        query = query.filter(
            Entry.amount <= price_max
        )

    if category_filter:

        query = query.filter(
            Entry.category == category_filter
        )

    # ─────────────────────────────────────────────
    # Categories
    # ─────────────────────────────────────────────

    categories = (
        db.session
        .query(Entry.category)
        .filter(Entry.user_id == current_user.id)
        .distinct()
        .all()
    )

    categories = [
        cat[0]
        for cat in categories
        if cat[0]
    ]

    # ─────────────────────────────────────────────
    # Sorting
    # ─────────────────────────────────────────────

    if sort_by == 'amount':

        if sort_order == 'asc':
            query = query.order_by(
                Entry.amount.asc()
            )

        elif sort_order == 'desc':
            query = query.order_by(
                Entry.amount.desc()
            )

    elif sort_by == 'category':

        if sort_order == 'asc':
            query = query.order_by(
                Entry.category.asc()
            )

        elif sort_order == 'desc':
            query = query.order_by(
                Entry.category.desc()
            )

    # ─────────────────────────────────────────────
    # Pagination
    # ─────────────────────────────────────────────

    pagination = query.paginate(
        page=page,
        per_page=5,
        error_out=False
    )

    results = pagination.items

    return render_template(
        'search.html',
        pagination=pagination,
        page=page,
        total_pages=pagination.pages,
        total_items=pagination.total,
        results=results,
        amount=amount,
        category=category,
        description=description,
        price_min=price_min,
        price_max=price_max,
        category_filter=category_filter,
        categories=categories,
        sort_by=sort_by,
        sort_order=sort_order
    )


# ─────────────────────────────────────────────────────────────
# Home
# ─────────────────────────────────────────────────────────────

@app.route('/')
def home():

    if current_user.is_authenticated:
        return redirect(url_for('dashboard'))

    return redirect(url_for('login'))


# ─────────────────────────────────────────────────────────────
# Create databases
# ─────────────────────────────────────────────────────────────

if __name__ == '__main__':

    with app.app_context():

        db.create_all()

    app.run(
        host="0.0.0.0",
        port=int(os.environ.get("PORT", 8000))
    )
